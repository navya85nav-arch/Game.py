# 14. START GAME
# ==========================================

def start_game():

    global score
    global start_time
    global remaining_time
    global last_spawn
    global previous_mouse

    score = 0
    remaining_time = game_duration

    fruits.clear()
    particles.clear()
    trail.clear()

    previous_mouse = None

    start_time = pygame.time.get_ticks()
    last_spawn = start_time


