# ==========================================
# 19. PAUSE SCREEN
# ==========================================

def draw_pause():

    overlay = pygame.Surface(
        (WIDTH, HEIGHT),
        pygame.SRCALPHA
    )

    overlay.fill((0, 0, 0, 175))
    screen.blit(overlay, (0, 0))

    draw_glass(300, 200, 500, 400)

    draw_text(
        "GAME PAUSED",
        TITLE_FONT,
        CYAN,
        355, 230
    )

    resume_button.draw()
    restart_button.draw()
    menu_button.draw()


# ==========================================
# 20. MAIN GAME LOOP
# ==========================================

running = True

while running:

    clock.tick(60)

    draw_background()

    mouse_position = pygame.mouse.get_pos()

    # --------------------------------------
    # EVENTS
    # --------------------------------------

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_ESCAPE:

                if game_state == "playing":
                    game_state = "paused"

                elif game_state == "paused":
                    game_state = "playing"

                elif game_state in ["leaderboard", "difficulty"]:
                    game_state = "menu"

                elif game_state == "menu":
                    running = False

            if event.key == pygame.K_SPACE:

                if game_state == "menu":
                    game_state = "difficulty"

                elif game_state == "difficulty":
                    start_game()
                    game_state = "playing"

            if event.key == pygame.K_p:

                if game_state == "playing":
                    game_state = "paused"

                elif game_state == "paused":
                    game_state = "playing"

        # Mouse slicing
        if event.type == pygame.MOUSEMOTION:

            if game_state == "playing":

                current = event.pos

                if previous_mouse is not None:

                    slice_fruits(
                        previous_mouse,
                        current
                    )

                trail.append(current)

                previous_mouse = current

            else:
                previous_mouse = None

        # Mouse clicks
        if event.type == pygame.MOUSEBUTTONDOWN:

            if game_state == "menu":

                if play_button.clicked(event):
                    game_state = "difficulty"

                elif leaderboard_button.clicked(event):
                    game_state = "leaderboard"

                elif exit_button.clicked(event):
                    running = False

            elif game_state == "difficulty":

                if easy_button.clicked(event):
                    difficulty = "EASY"
                    start_game()
                    game_state = "playing"

                elif medium_button.clicked(event):
                    difficulty = "MEDIUM"
                    start_game()
                    game_state = "playing"

                elif expert_button.clicked(event):
                    difficulty = "EXPERT"
                    start_game()
                    game_state = "playing"

            elif game_state == "paused":

                if resume_button.clicked(event):
                    game_state = "playing"

                elif restart_button.clicked(event):
                    start_game()
                    game_state = "playing"

                elif menu_button.clicked(event):
                    game_state = "menu"

            elif game_state == "gameover":

                if restart_button.clicked(event):
                    start_game()
                    game_state = "playing"

                elif menu_button.clicked(event):
                    game_state = "menu"

    # --------------------------------------
    # MENU
    # --------------------------------------

    if game_state == "menu":

        draw_menu()

    # --------------------------------------
    # DIFFICULTY
    # --------------------------------------

    elif game_state == "difficulty":

        draw_difficulty()

    # --------------------------------------
    # LEADERBOARD
    # --------------------------------------

    elif game_state == "leaderboard":

        draw_leaderboard()

    # --------------------------------------
    # PLAYING
    # --------------------------------------

    elif game_state == "playing":

        elapsed = (
            pygame.time.get_ticks() - start_time
        ) // 1000

        remaining_time = max(
            0,
            game_duration - elapsed
        )

        # Spawn fruits
        current_time = pygame.time.get_ticks()

        spawn_delay = DIFFICULTIES[difficulty]["spawn"]

        if current_time - last_spawn > spawn_delay:

            create_fruit()
            last_spawn = current_time

        # Update fruits
        for fruit in fruits[:]:

            fruit["x"] += fruit["vx"]
            fruit["y"] += fruit["vy"]

            fruit["vy"] += fruit["gravity"]

            draw_fruit(fruit)

            if fruit["y"] > HEIGHT + 80:
                fruits.remove(fruit)

        # Slicing trail
        if len(trail) > 12:
            trail.pop(0)

        if len(trail) > 1:

            pygame.draw.lines(
                screen,
                CYAN,
                False,
                trail,
                4
            )

        # Score panel
        draw_glass(20, 15, 230, 65)

        draw_text(
            f"SCORE: {score}",
            FONT,
            CYAN,
            45, 28
        )

        # Timer panel
        draw_glass(830, 15, 245, 65)

        timer_color = PINK if remaining_time <= 10 else WHITE

        draw_text(
            f"TIME: {remaining_time}",
            FONT,
            timer_color,
            860, 28
        )

        draw_text(
            difficulty,
            SMALL_FONT,
            CYAN,
            480, 30
        )

        draw_text(
            "P = PAUSE",
            TINY_FONT,
            WHITE,
            490, 65
        )

        update_particles()

        # Time over
        if remaining_time <= 0:

            save_score()
            game_state = "gameover"

    # --------------------------------------
    # PAUSED
    # --------------------------------------

    elif game_state == "paused":

        # Show pause menu
        draw_pause()

    # --------------------------------------
    # GAME OVER
    # --------------------------------------

    elif game_state == "gameover":

        update_particles()
        draw_gameover()

    pygame.display.flip()


pygame.quit()
sys.exit()
