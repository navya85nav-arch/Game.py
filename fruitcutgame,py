def draw_background():

    screen.fill(BLACK)

    # Gradient-style background
    for y in range(0, HEIGHT, 5):

        ratio = y / HEIGHT

        r = int(18 + ratio * 22)
        g = int(12 + ratio * 10)
        b = int(45 + ratio * 45)

        pygame.draw.rect(
            screen,
            (r, g, b),
            (0, y, WIDTH, 5)
        )

    # Floating particles
    for p in background_particles:

        p["y"] -= p["speed"]

        if p["y"] < 0:
            p["y"] = HEIGHT
            p["x"] = random.randint(0, WIDTH)

        pygame.draw.circle(
            screen,
            (65, 75, 130),
            (int(p["x"]), int(p["y"])),
            p["size"]
        )


