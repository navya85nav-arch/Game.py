# ==========================================
# 10. FRUIT CREATION
# ==========================================

def create_fruit():

    name, color = random.choice(FRUIT_TYPES)

    fruit = {
        "x": random.randint(100, WIDTH - 100),
        "y": HEIGHT + 40,
        "vx": random.uniform(-3, 3),
        "vy": -random.uniform(
            DIFFICULTIES[difficulty]["speed"],
            DIFFICULTIES[difficulty]["speed"] + 4
        ),
        "gravity": 0.15,
        "radius": random.randint(25, 34),
        "color": color,
        "name": name
    }

    fruits.append(fruit)


# ==========================================
# 11. DRAW FRUITS
# ==========================================

def draw_fruit(fruit):

    x = int(fruit["x"])
    y = int(fruit["y"])
    radius = fruit["radius"]

    pygame.draw.circle(
        screen,
        fruit["color"],
        (x, y),
        radius
    )

    # Fruit shine
    pygame.draw.circle(
        screen,
        (255, 255, 255),
        (x - 9, y - 10),
        6
    )

    # Fruit stem
    pygame.draw.line(
        screen,
        GREEN,
        (x, y - radius),
        (x + 5, y - radius - 12),
        4
    )


# ==========================================
# 12. SLICING PARTICLES
# ==========================================

def create_particles(x, y, color):

    for i in range(16):

        angle = random.uniform(0, math.pi * 2)
        speed = random.uniform(2, 6)

        particles.append({
            "x": x,
            "y": y,
            "vx": math.cos(angle) * speed,
            "vy": math.sin(angle) * speed,
            "life": 30,
            "color": color
        })


def update_particles():

    for p in particles[:]:

        p["x"] += p["vx"]
        p["y"] += p["vy"]

        p["vy"] += 0.15
        p["life"] -= 1

        if p["life"] <= 0:
            particles.remove(p)

        else:

            pygame.draw.circle(
                screen,
                p["color"],
                (int(p["x"]), int(p["y"])),
                4
            )


# ==========================================
# 13. MOUSE SLICING DETECTION
# ==========================================

previous_mouse = None


def distance_to_segment(point, start, end):

    px, py = point
    x1, y1 = start
    x2, y2 = end

    dx = x2 - x1
    dy = y2 - y1

    if dx == 0 and dy == 0:
        return math.hypot(px - x1, py - y1)

    t = (
        (px - x1) * dx + (py - y1) * dy
    ) / (dx * dx + dy * dy)

    t = max(0, min(1, t))

    closest_x = x1 + t * dx
    closest_y = y1 + t * dy

    return math.hypot(
        px - closest_x,
        py - closest_y
    )


def slice_fruits(start, end):

    global score

    for fruit in fruits[:]:

        distance = distance_to_segment(
            (fruit["x"], fruit["y"]),
            start,
            end
        )

        if distance < fruit["radius"] + 12:

            score += 10

            create_particles(
                fruit["x"],
                fruit["y"],
                fruit["color"]
            )

            fruits.remove(fruit)


